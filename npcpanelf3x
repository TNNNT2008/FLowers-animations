local function C_ce()
local script = G2L["ce"];
	local slider = script.Parent
	local player = game.Players.LocalPlayer
	local uiGradient = slider:WaitForChild("UIGradient")
	
	-- Функция для получения точного цвета из градиента по шкале от 0 до 1
	local function getColorFromGradient(gradient, percentage)
		local keypoints = gradient.Color.Keypoints
		-- Ограничиваем значение от 0 до 1
		percentage = math.clamp(percentage, 0, 1)
	
		for i = 1, #keypoints - 1 do
			local left = keypoints[i]
			local right = keypoints[i + 1]
			if percentage >= left.Time and percentage <= right.Time then
					-- Вычисляем смешение цветов между двумя точками
					local alpha = (percentage - left.Time) / (right.Time - left.Time)
					return left.Value:Lerp(right.Value, alpha)
				end
		end
		return keypoints[#keypoints].Value
	end
	
	-- Обработка нажатия на слайдер
	slider.MouseButton1Down:Connect(function()
		local mouse = player:GetMouse()
		local connection
	
		local function updateColor()
			-- Находим, в каком месте полоски находится мышь (в процентах от 0 до 1)
			local relativeX = (mouse.X - slider.AbsolutePosition.X) / slider.AbsoluteSize.X
			local selectedColor = getColorFromGradient(uiGradient, relativeX)
	
			---------------------------------------------------------
			-- ТУТ ВАШ КОД: Применяем цвет к голове персонажа
			local Head = script.Parent.Parent.Parent.Parent.Parent.Parent.Parent.Settings.Color.Head
			if Head then
				Head.Value = selectedColor
			end
			---------------------------------------------------------
		end
	
		-- Обновляем цвет сразу при клике и следим за движением мыши, пока кнопка зажата
		updateColor()
		connection = mouse.Move:Connect(updateColor)
	
		-- Отключаем слежение, когда игрок отпускает кнопку мыши
		local releaseConnection
		releaseConnection = game:GetService("UserInputService").InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				connection:Disconnect()
				releaseConnection:Disconnect()
			end
		end)
	end)
	
end;
