local function C_2()
local script = G2L["2"];
	local ANIM_IDS = {
		idle = "rbxassetid://180435571",
		walk = "rbxassetid://180426354",
		run = "rbxassetid://180426354",
		jump = "rbxassetid://125750702",
		fall = "rbxassetid://180436148",
		dance1 = "rbxassetid://182435998",
		dance2 = "rbxassetid://182436842",
		wave = "rbxassetid://128777973"
	}
	
	local RunService = game:GetService("RunService")
	local LocalNPCs = workspace:WaitForChild("FakeChars")
	if not LocalNPCs then
		LocalNPCs = workspace:WaitForChild("FakeChars", 10)
	end
	
	-- Таблица для хранения загруженных треков для каждого NPC
	local activeNpcs = {} 
	
	local function registerNPC(npc)
		local humanoid = npc:WaitForChild("Humanoid", 5)
		local animator = humanoid and humanoid:WaitForChild("Animator", 5)
		if not animator then return end
	
		local tracks = {}
		-- Загружаем анимации заранее, чтобы не делать это в цикле
		for name, id in pairs(ANIM_IDS) do
			local anim = Instance.new("Animation")
			anim.AnimationId = id
			tracks[name] = animator:LoadAnimation(anim)
		end
	
		activeNpcs[npc] = {
			humanoid = humanoid,
			rootPart = npc:WaitForChild("HumanoidRootPart"),
			tracks = tracks,
			currentAnim = nil
		}
	end
	
	local function unregisterNPC(npc)
		if activeNpcs[npc] then
			-- Останавливаем все треки перед удалением
			for _, track in pairs(activeNpcs[npc].tracks) do
				track:Stop()
			end
			activeNpcs[npc] = nil
		end
	end
	
	-- Отслеживаем появление и удаление NPC
	LocalNPCs.ChildAdded:Connect(registerNPC)
	LocalNPCs.ChildRemoved:Connect(unregisterNPC)
	for _, npc in ipairs(LocalNPCs:GetChildren()) do registerNPC(npc) end
	
	-- Главный поток анимации (работает эффективнее, чем 100 отдельных скриптов)
	RunService.Heartbeat:Connect(function()
		for npc, data in pairs(activeNpcs) do
			if not npc.Parent or not data.rootPart then continue end
	
			local velocity = data.rootPart.AssemblyLinearVelocity
			local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
			local verticalSpeed = velocity.Y
	
			local nextAnim = "idle"
	
			-- Логика переключения состояний
			if data.humanoid.FloorMaterial == Enum.Material.Air then
				if verticalSpeed > 1 then
					nextAnim = "jump"
				else
					nextAnim = "fall"
				end
			elseif speed > 0.5 then
				nextAnim = "walk" -- или "run" в зависимости от порога скорости
			end
	
			-- Воспроизводим анимацию, только если состояние изменилось
			if data.currentAnim ~= nextAnim then
				if data.currentAnim and data.tracks[data.currentAnim] then
					data.tracks[data.currentAnim]:Stop(0.2) -- Плавное затухание
				end
	
				data.currentAnim = nextAnim
				local track = data.tracks[nextAnim]
				if track then
					track:Play(0.2, 1, 1) -- Плавный переход
	
					-- Динамически меняем скорость анимации ходьбы под скорость движения
					if nextAnim == "walk" then
						track:AdjustSpeed(speed / 16) -- 16 — стандартная скорость Humanoid
					end
				end
			elseif nextAnim == "walk" then
				-- Обновляем скорость анимации ходьбы, если NPC ускорился/замедлился
				data.tracks["walk"]:AdjustSpeed(speed / 16)
			end
		end
	end)
	
end;
