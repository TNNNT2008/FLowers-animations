	local PathfindingService = game:GetService("PathfindingService")
	local function MoveNPCWithPathfind(localNPC, targetPosition)
		local npcObject = npclimbandnpc[localNPC]
		if not npcObject then return end
	
		local humanoid = localNPC:FindFirstChild("Humanoid")
		local rootPart = localNPC:FindFirstChild("HumanoidRootPart")
		if not humanoid or not rootPart then return end
	
	
		local path = PathfindingService:CreatePath({
			AgentRadius = 2,
			AgentHeight = 5,
			AgentCanJump = true
		})
	
		path:ComputeAsync(rootPart.Position, targetPosition)
	
		if path.Status == Enum.PathStatus.Success then
			npcObject.Waypoints = path:GetWaypoints()
	
			if #npcObject.Waypoints > 1 then
				npcObject.CurrentWaypointIndex = 2
			else
				npcObject.CurrentWaypointIndex = 1
			end
	
	
			-- Говорим гуманоиду идти к первой точке маршрута
			humanoid:MoveTo(npcObject.Waypoints[npcObject.CurrentWaypointIndex].Position)
	
			-- Если путь требует прыжка
			if npcObject.Waypoints[1].Action == Enum.PathWaypointAction.Jump then
				humanoid.Jump = true
			end
	
			if npcObject and npcObject.PathConnection then
				npcObject.PathConnection:Disconnect()
				npcObject.PathConnection = nil
			end
			-- Логика перехода от точки к точке
			if not npcObject.PathConnection then
				npcObject.PathConnection = humanoid.MoveToFinished:Connect(function(reached)
					if reached and npcObject.CurrentWaypointIndex < #npcObject.Waypoints then
						npcObject.CurrentWaypointIndex = npcObject.CurrentWaypointIndex + 1
						local nextWaypoint = npcObject.Waypoints[npcObject.CurrentWaypointIndex]
	
						humanoid:MoveTo(nextWaypoint.Position)
						if nextWaypoint.Action == Enum.PathWaypointAction.Jump then
							humanoid.Jump = true
						end
					else
						-- Путь завершен или прерван
						if npcObject.PathConnection then
							npcObject.PathConnection:Disconnect()
							npcObject.PathConnection = nil
						end
					end
				end)
			end
		end
	end
	
