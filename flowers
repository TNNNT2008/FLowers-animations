local AnimatorCache = { Joints = {}, AnimDefaults = {}, JointTypes = {}, Rigs = {} }
local ScriptSettings = { Options = { AnimationSpeed = 1, AnimationBlending = 0.25 } }
local ActiveTweens = {}

-- Функция регистрации суставов (работает для ЛЮБОЙ модели: игрока или NPC)
local function RegisterRigJoints(Rig: Model)
	if AnimatorCache.Joints[Rig] then return end -- Уже зарегистрирован, пропускаем

	AnimatorCache.Joints[Rig] = {}
	AnimatorCache.AnimDefaults[Rig] = {}
	AnimatorCache.JointTypes[Rig] = {}

	-- Удаляем стандартный Animator на клиенте, чтобы он не блокировал наши CFrame
	local humanoid = Rig:FindFirstChildOfClass("Humanoid")
	if humanoid then
		local animator = humanoid:FindFirstChildOfClass("Animator")
		if animator then animator:Destroy() end
	end

	for i, v in ipairs(Rig:GetDescendants()) do
		if v:IsA("Bone") then
			AnimatorCache.Joints[Rig][v.Name] = v
			AnimatorCache.AnimDefaults[Rig][v.Name] = v.CFrame
			AnimatorCache.JointTypes[Rig][v.Name] = "Bone"
		elseif v:IsA("Motor6D") and v.Part1 then
			AnimatorCache.Joints[Rig][v.Part1.Name] = v
			AnimatorCache.AnimDefaults[Rig][v.Part1.Name] = CFrame.identity
			AnimatorCache.JointTypes[Rig][v.Part1.Name] = "Motor6D"

			AnimatorCache.Joints[Rig][v.Name] = v
			AnimatorCache.AnimDefaults[Rig][v.Name] = CFrame.identity
			AnimatorCache.JointTypes[Rig][v.Name] = "Motor6D"
		end
	end
end

local function EditJoint(Joint, TargetCFrame, Duration, Style, Direction, IsBone)
	local targetStyle
	if Style and Style.Name == "CubicV2" then
		-- Подменяем стиль на стандартный Cubic из библиотеки Roblox
		targetStyle = Enum.EasingStyle.Cubic
	end
	local Property = IsBone and "CFrame" or "Transform"

	-- ИСПРАВЛЕНО: Перед запуском нового твина полностью УНИЧТОЖАЕМ старый из памяти,
	-- а не просто отменяем его! Это мгновенно вернет стабильный FPS.
	if ActiveTweens[Joint] then
		ActiveTweens[Joint]:Cancel()
		ActiveTweens[Joint]:Destroy() -- Освобождаем оперативную память
		ActiveTweens[Joint] = nil
	end

	if typeof(Style) == "EnumItem" and Style.Name == "Constant" then
		Joint[Property] = TargetCFrame
		return
	end
	if Style and Style.Name == "CubicV2" then
		Style = Enum.EasingStyle.Cubic or Enum.EasingStyle.Linear
	else
		Style = Enum.EasingStyle[Style.Name] or Enum.EasingStyle.Linear
	end
	Direction = Enum.EasingDirection[Direction.Name] or Enum.EasingDirection.In

	local StartCFrame = Joint[Property]
	local FinalCFrame = StartCFrame:Lerp(TargetCFrame, ScriptSettings.Options.AnimationBlending)

	local Tween = Services.TweenService:Create(
		Joint, 
		TweenInfo.new(Duration, Style, Direction), 
		{ [Property] = FinalCFrame }
	)

	ActiveTweens[Joint] = Tween
	Tween:Play()

	-- ИСПРАВЛЕНО: Надежная очистка памяти по завершению
	Tween.Completed:Connect(function()
		if ActiveTweens[Joint] == Tween then
			ActiveTweens[Joint] = nil
		end
		Tween:Destroy() -- Уничтожаем твин, как только он закончил движение
	end)
end


local function LoadAnimation(Rig: Model, KeyframeSequence: KeyframeSequence)
	local Keyframes = KeyframeSequence:GetKeyframes()
	table.sort(Keyframes, function(a, b) return a.Time < b.Time end)

	local Class = {
		Speed = 1,
		Length = Keyframes[#Keyframes].Time,
		Stopped = true,
		IsPlaying = false,
		TimePosition = 0,
		Looped = KeyframeSequence.Loop
	}

	local HeartbeatConnection = nil

	-- КРИТИЧЕСКИЙ ФИКС 1: Запоминаем последний обработанный кадр,
	-- чтобы не спамить твинами, пока время идет внутри одного и того же кадра!
	local lastProcessedKeyframe = nil

	function Class:Play(Speed)
		RegisterRigJoints(Rig)

		Class.Speed = Speed or 1
		Class.Stopped = false
		Class.IsPlaying = true
		Class.TimePosition = 0
		lastProcessedKeyframe = nil -- Сбрасываем кэш кадров

		if HeartbeatConnection then HeartbeatConnection:Disconnect() end

		HeartbeatConnection = Services.RunService.Heartbeat:Connect(function(dt)
			if Class.Stopped or not Class.IsPlaying then
				if HeartbeatConnection then HeartbeatConnection:Disconnect() end
				return
			end

			Class.TimePosition += dt * Class.Speed * ScriptSettings.Options.AnimationSpeed

			-- Зацикливание или остановка по окончании
			if Class.TimePosition >= Class.Length then
				if Class.Looped then
					Class.TimePosition = math.fmod(Class.TimePosition, Class.Length)
					lastProcessedKeyframe = nil -- Сбрасываем кэш при новом круге
				else
					Class.TimePosition = Class.Length
					Class:Stop()
					return
				end
			end

			-- Бинарный/линейный поиск текущего кадра
			local K1 = Keyframes[1]
			local K2 = nil

			for i = 1, #Keyframes do
				if Keyframes[i].Time <= Class.TimePosition then
					K1 = Keyframes[i]
					K2 = Keyframes[i + 1]
				else
					break
				end
			end

			-- КРИТИЧЕСКИЙ ФИКС 2: Если мы ВСЁ ЕЩЁ находимся на том же ключевом кадре,
			-- мы ПРОСТО ПРОПУСКАЕМ этот шаг! Никаких новых твинов не создается!
			if K1 == lastProcessedKeyframe then
				return 
			end

			-- Запоминаем, что мы зашли на этот кадр, блокируя повторный спам
			lastProcessedKeyframe = K1

			if K1 then
				local Duration = 0.05
				if K2 then
					-- Рассчитываем точную чистую длительность перехода до следующего кадра
					Duration = (K2.Time - K1.Time) / (Class.Speed * ScriptSettings.Options.AnimationSpeed)
				end

				-- Этот цикл теперь сработает ровно ОДИН РАЗ за смену кадра! (Например, 5-10 раз в секунду вместо 120)
				for i, Pose in ipairs(K1:GetDescendants()) do
					if Pose:IsA("Pose") then
						local targetName = Pose.Name

						if targetName == "HumanoidRootPart" then
							if AnimatorCache.Joints[Rig]["RootJoint"] then
								targetName = "RootJoint"
							elseif AnimatorCache.Joints[Rig]["Root"] then
								targetName = "Root"
							end
						end

						local Joint = AnimatorCache.Joints[Rig][targetName]
						if Joint then
							local IsBone = AnimatorCache.JointTypes[Rig][targetName] == "Bone"
							local TargetCF = AnimatorCache.AnimDefaults[Rig][targetName] * Pose.CFrame

							-- Запускаем ОДИН идеальный Твин, который плавно доиграет до конца своей Duration
							EditJoint(Joint, TargetCF, Duration, Pose.EasingStyle, Pose.EasingDirection, IsBone)
						end
					end
				end
			end
		end)
	end

	function Class:Stop()
		Class.Stopped = true
		Class.IsPlaying = false
		lastProcessedKeyframe = nil
		if HeartbeatConnection then
			HeartbeatConnection:Disconnect()
			HeartbeatConnection = nil
		end
		if AnimatorCache.Joints[Rig] then
			for name, joint in pairs(AnimatorCache.Joints[Rig]) do
				if AnimatorCache.JointTypes[Rig][name] == "Motor6D" then
					joint.Transform = CFrame.identity
				end
			end
		end
	end

	return Class
end

