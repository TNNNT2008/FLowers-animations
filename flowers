task.spawn(function()
	local tweenService = game:GetService("TweenService")
	local tweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

	-- Флаг текущего состояния невидимости (false = видимый, true = невидимый)
	local isCurrentlyInvisible = false

	-- Проверяем, существует ли голова перед стартом, чтобы избежать ошибок nil
	local head = createdLimbs[1]
	if not head then return end

	-- Основной цикл работает, пока форма не сменилась на Shapeshift
	while form ~= "Shapeshift" do
		local camera = workspace.CurrentCamera -- Использовать CurrentCamera быстрее и надежнее, чем WaitForChild

		if camera and head and head.Parent then
			local distance = (camera.CFrame.Position - head.Position).Magnitude

			-- ЕСЛИ ИГРОК ПОДОШЕЛ БЛИЗКО (и клон еще НЕ невидим)
			if distance < 2 and not isCurrentlyInvisible then
				isCurrentlyInvisible = true -- Меняем флаг, чтобы твин больше НЕ перезапускался!

				for _, part in ipairs(createdLimbs) do
					local tween = tweenService:Create(part, tweenInfo, {Transparency = 1})
					tween:Play()

					-- Очищаем память сразу после завершения анимации, предотвращая утечку FPS!
					tween.Completed:Connect(function()
						tween:Destroy()
					end)
				end
				

				-- ЕСЛИ ИГРОК ОТОШЕЛ (и клон все еще невидим)
			elseif distance >= 2 and isCurrentlyInvisible then
				isCurrentlyInvisible = false -- Меняем флаг обратно

				for _, part in ipairs(createdLimbs) do
					local tween = tweenService:Create(part, tweenInfo, {Transparency = 0})
					tween:Play()

					tween.Completed:Connect(function()
						tween:Destroy()
					end)
				end
				
			end
		end

		-- Спокойно ждем 0.1 секунды. Проверка дистанции не грузит процессор
		task.wait(0.1)
	end


end)


local function changeColorInStages(partsArray, startColor, targetColor, totalStages, delayBetweenStages)
	-- Запускаем цикл от 1 до количества ваших стадий (например, 10 шагов)
	for stage = 1, totalStages do

		-- Вычисляем процент перехода для текущей стадии (число от 0.0 до 1.0)
		local alpha = stage / totalStages

		-- Магия Lerp: вычисляем промежуточный цвет между стартовым и финальным
		local intermediateColor = startColor:Lerp(targetColor, alpha)

		-- Собираем массив изменений цвета для F3X под сигнатуру вашего SyncColor
		local colorBatch = {}
		for _, part in ipairs(partsArray) do
			if part and part.Parent then
				table.insert(colorBatch, {
					Part = part,
					Color = intermediateColor
				})
			end
		end

		-- Отправляем текущую стадию цвета на сервер
		if #colorBatch > 0 then
			pcall(function()
				SyncAPI:Invoke("SyncColor", colorBatch)
			end)
		end

		-- ОБЯЗАТЕЛЬНО делаем небольшую паузу между стадиями, чтобы они не пролетели мгновенно
		task.wait(delayBetweenStages)
	end
end

